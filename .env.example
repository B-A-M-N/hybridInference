OPENAI_API_KEY=<YOUR_API_KEY_HERE>
OPENAI_BASE_URL=https://api.openai.com/v1

LLAMA_API_KEY=<YOUR_API_KEY_HERE>
LLAMA_BASE_URL=https://api.llama.com/compat/v1/

GEMINI_API_KEY=<YOUR_API_KEY_HERE>

DEEPSEEK_API_KEY=<YOUR_API_KEY_HERE>

# Local VLLM server (freeinference.org or your own deployment)
LOCAL_BASE_URL=http://freeinference.org/v1

OFFLOAD=

# Database (PostgreSQL)
# Start with: docker compose -f infrastructure/docker/docker-compose.yml up -d
DB_HOST=localhost
DB_PORT=5432
DB_NAME=freeinference_db
DB_USER=murphy
DB_PASSWORD=harvardsys
DB_ENABLED=true

# Observability
METRICS_ENABLED=1
# full|family — set to family to coarsen model labels
METRICS_MODEL_LABEL=full

# Logging
LOG_FORMAT=json
LOG_LEVEL=INFO

# Routing health & circuit breaker
ROUTER_HEALTH_EWMA_ALPHA=0.2
CIRCUIT_FAILURE_THRESHOLD=3
CIRCUIT_COOLDOWN_SECONDS=30
CIRCUIT_MIN_AVAILABILITY=0.7
