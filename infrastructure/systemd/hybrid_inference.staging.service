[Unit]
Description=HybridInference (staging)
Wants=network-online.target
After=network-online.target docker.service

[Service]
User=yspark
Group=yspark
Type=simple
WorkingDirectory=/users/yspark/hybridInference

EnvironmentFile=/users/yspark/hybridInference/.env
Environment=PYTHONPATH=/users/yspark/hybridInference

# Runs on port 8000, bound to all interfaces so it's reachable on the CloudLab public IP.
# Change --host to 127.0.0.1 if a reverse proxy is added later.
ExecStart=/users/yspark/hybridInference/.venv/bin/uvicorn serving.servers.app:app \
  --host 0.0.0.0 \
  --port 8000 \
  --no-server-header

Restart=on-failure
RestartSec=5s
LimitNOFILE=65536

NoNewPrivileges=true
ProtectSystem=full
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
