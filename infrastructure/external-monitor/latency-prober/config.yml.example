# LLM Latency Prober — example configuration.
# Copy to config.yml and edit before deploying.
#
# Each target sends one streaming request every probe_interval_seconds and
# records TTFT, throughput, and success in Prometheus metrics labelled by
# target name and model.
#
# Use url: http://localhost:8080/v1/chat/completions for direct local testing without
# going through the load balancer or Llama API.

# How often to send a probe request (in seconds).
probe_interval_seconds: 300  # 5 minutes

# TCP port for the Prometheus /metrics endpoint.
metrics_port: 9116

targets:
  # ── Local self-hosted models (free) ────────────────────────────────────────
  # These exercise the local GPU serving path (vLLM / SGLang on the main server).

  - name: freeinference-glm-4.7-flash
    url: https://freeinference.org/v1/chat/completions
    model: glm-4.7-flash          # local vLLM on port 8004, free
    api_key_env: FREEINFERENCE_API_KEY
    timeout_seconds: 60

  - name: freeinference-qwen3-coder-30b
    url: https://freeinference.org/v1/chat/completions
    model: qwen3-coder-30b        # local SGLang on port 8003 (+ Chutes fallback), free
    api_key_env: FREEINFERENCE_API_KEY
    timeout_seconds: 60

  - name: freeinference-minimax-m2
    url: https://freeinference.org/v1/chat/completions
    model: minimax-m2             # local SGLang on port 12004 (+ MiniMax API fallback), free
    api_key_env: FREEINFERENCE_API_KEY
    timeout_seconds: 60

  # ── Remote cloud API models (via Llama API, free) ──────────────────────────
  # These exercise the Llama API routing path.

  - name: freeinference-llama-3.3-70b
    url: https://freeinference.org/v1/chat/completions
    model: llama-3.3-70b-instruct
    api_key_env: FREEINFERENCE_API_KEY
    timeout_seconds: 60

  - name: freeinference-llama-4-scout
    url: https://freeinference.org/v1/chat/completions
    model: llama-4-scout
    api_key_env: FREEINFERENCE_API_KEY
    timeout_seconds: 60

  # ── Remote cloud API models (paid) ─────────────────────────────────────────

  - name: freeinference-glm-4.7
    url: https://freeinference.org/v1/chat/completions
    model: glm-4.7                # Zhipu remote API, ~$0.06/day to probe
    api_key_env: FREEINFERENCE_API_KEY
    timeout_seconds: 60

  - name: freeinference-glm-5
    url: https://freeinference.org/v1/chat/completions
    model: glm-5                  # Zhipu remote API, ~$0.09/day to probe
    api_key_env: FREEINFERENCE_API_KEY
    timeout_seconds: 60

  - name: freeinference-minimax-m2.5
    url: https://freeinference.org/v1/chat/completions
    model: minimax-m2.5           # MiniMax remote API, ~$0.03/day to probe
    api_key_env: FREEINFERENCE_API_KEY
    timeout_seconds: 60
